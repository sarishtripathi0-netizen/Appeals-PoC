{
  "name": "sewa-setu-appeals-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Proof of concept: Appeal Management System for Sewa Setu (ARTPS Act), with a simulated clock and demo scenarios.",
  "scripts": {
    "setup": "prisma migrate deploy && prisma generate && tsx prisma/seed.ts",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "seed": "tsx prisma/seed.ts",
    "mdm:sync": "tsx scripts/mdm-sync.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "15.5.28",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.18",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
